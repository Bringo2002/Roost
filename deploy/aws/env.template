# ==============================================================================
# Roost Application Environment Configuration Template
# ==============================================================================
# Copy this file to /etc/roost/env on your EC2 instance and substitute the
# placeholder values with your real production secrets.
#
# File permissions should be strictly locked down:
#   sudo cp env.template /etc/roost/env
#   sudo chown roost:roost /etc/roost/env
#   sudo chmod 600 /etc/roost/env
#
# NOTE FOR SYSTEMD EnvironmentFile:
# - Values are parsed as plain strings without shell expansion.
# - If a value contains newlines (like JSON), keep it on a single line or escape.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for the embedded Tomcat container (default: 8080). Nginx proxies to this.
PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Configuration (AWS RDS PostgreSQL)
# ------------------------------------------------------------------------------
# JDBC Connection URL pointing to your Amazon RDS PostgreSQL instance.
# Example: jdbc:postgresql://roost-db.cxyz123.eu-north-1.rds.amazonaws.com:5432/roost?sslmode=require
# IMPORTANT: Include ?sslmode=require — RDS requires SSL connections.
SPRING_DATASOURCE_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/roost?sslmode=require

# Master or application database username configured on your RDS instance.
SPRING_DATASOURCE_USERNAME=roost_admin

# Database password for the above user.
SPRING_DATASOURCE_PASSWORD=<YOUR_RDS_PASSWORD>

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# High-entropy HMAC-SHA256 secret key for signing and validating JWT auth tokens.
# Must be at least 256 bits (32 bytes / 64 hex characters minimum).
# Generate using: openssl rand -hex 64
JWT_SECRET=<GENERATE_A_STRONG_SECRET_64_CHARS_MIN>

# ------------------------------------------------------------------------------
# 4. Storage (Amazon S3 / S3-Compatible Object Store)
# ------------------------------------------------------------------------------
# AWS Region where your S3 bucket resides.
S3_REGION=eu-north-1

# Name of the S3 bucket used for property images, attachments, and media uploads.
S3_BUCKET=<YOUR_S3_BUCKET_NAME>

# IAM user access key credentials with PutObject/GetObject permissions on S3_BUCKET.
# (If using IAM instance roles on EC2, this can be left blank if AWS SDK auto-discovers role).
S3_ACCESS_KEY_ID=<YOUR_IAM_ACCESS_KEY>
S3_SECRET_ACCESS_KEY=<YOUR_IAM_SECRET_KEY>

# Base URL for serving public media (property photos, videos).
# Format: https://<YOUR_S3_BUCKET>.s3.eu-north-1.amazonaws.com (or CloudFront CDN domain)
S3_PUBLIC_BASE_URL=https://<YOUR_S3_BUCKET>.s3.eu-north-1.amazonaws.com

# ------------------------------------------------------------------------------
# 5. Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
# Complete JSON credentials from Google Cloud / Firebase Console
# (Project Settings -> Service Accounts -> Generate new private key).
# Must be placed on a single line for systemd EnvironmentFile compatibility.
FIREBASE_SERVICE_ACCOUNT_JSON=<PASTE_FULL_JSON_CONTENT_HERE>

# ------------------------------------------------------------------------------
# 6. AI Services (Google Gemini)
# ------------------------------------------------------------------------------
# API key for Google Gemini model calls (e.g. document verification, fraud checks).
# Obtain from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY=<YOUR_GEMINI_KEY>

# ------------------------------------------------------------------------------
# 7. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (e.g., https://roost.co.za,https://admin.roost.co.za).
# Leave empty if only native mobile applications (iOS/Android) call the API,
# as native apps do not send an Origin header.
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 8. Property Risk & Fraud Detection Algorithm Thresholds
# ------------------------------------------------------------------------------
# Price outlier ratio (flag if listing price is < ratio * area median).
RISK_PRICE_OUTLIER_RATIO=0.55

# Minimum tenant fraud reports before a property receives a warning flag.
RISK_MIN_REPORTS_TO_FLAG=1

# Minimum survey/visit responses required before evaluating negative ratio.
RISK_MIN_VISITED_RESPONSES_FOR_RATIO=3

# Threshold ratio of negative responses to flag property risk.
RISK_NEGATIVE_RATIO_THRESHOLD=0.5

# Radius in kilometers to search for comparable neighboring properties.
RISK_COMPARABLE_RADIUS_KM=2.0
